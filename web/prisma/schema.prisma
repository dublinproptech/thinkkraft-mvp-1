generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------- Authentication & Identity -------

model User {
  id        String   @id @default(cuid())
  username  String?  @unique // For child/student login (e.g., "Alice123")
  email     String?  @unique // For teacher/parent email login
  password  String   // Hashed password (adults) or hashed PIN (children)
  role      Role
  createdAt DateTime @default(now())

  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id])

  teacherId String?  @unique
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  parentId  String?  @unique
  parent    Parent?  @relation(fields: [parentId], references: [id])
}

// ------- People ------

model Parent {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  students Student[]
  consents Consent[]
  user     User?
}

model Student {
  id          String   @id @default(cuid())
  displayName String
  ageBand     String
  createdAt   DateTime @default(now())

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id])

  enrolments      Enrolment[]
  projects        Project[]
  hintEvents      HintEvent[]
  skills          SkillMastery[]
  consents        Consent[]
  studentProgress StudentProgress[]
  user            User?
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  // Stamped by the approval queue while a teacher has it open. It is how the
  // app knows whether anyone is watching, and so whether a hint has to wait
  // for a person or may go straight to the child.
  lastSeenAt DateTime?

  cohorts       Cohort[]
  approvedHints HintEvent[]
  user          User?
}

// ------- Curriculum --------

model Course {
  id        String   @id @default(cuid())
  title     String
  ageBand   String
  createdAt DateTime @default(now())

  lessons Lesson[]
  cohorts Cohort[]
}

model Lesson {
  id      String @id @default(cuid())
  orderNo Int
  goal    String
  // Nullable because lessons were seeded before this existed. Lists fall back
  // to the goal when it is empty.
  title   String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  projects        Project[]
  hintEvents      HintEvent[]
  studentProgress StudentProgress[]

  @@unique([courseId, orderNo])
}

model Cohort {
  id        String   @id @default(cuid())
  schedule  String
  createdAt DateTime @default(now())

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  enrolments Enrolment[]
}

// -------- Learning --------

model Enrolment {
  id        String          @id @default(cuid())
  status    EnrolmentStatus @default(TRIAL)
  createdAt DateTime        @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id])

  @@unique([studentId, cohortId])
}

model Project {
  id        String   @id @default(cuid())
  sb3Ref    String
  updatedAt DateTime @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id])
}

model HintEvent {
  id        String     @id @default(cuid())
  diagnosis String
  level     Int
  status    HintStatus @default(PROPOSED)
  text      String
  createdAt DateTime   @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  approvedById String?
  approvedBy   Teacher? @relation(fields: [approvedById], references: [id])

  // When this hint is a reply to one the child answered: what they wrote, and
  // which hint they were answering. The teacher approving a follow-up needs to
  // see the exchange, not an orphaned sentence, and a child's own words are
  // the one place something worth acting on is likely to surface.
  childAnswer    String?
  answeredHintId String?
  answeredHint   HintEvent?  @relation("HintThread", fields: [answeredHintId], references: [id])
  replies        HintEvent[] @relation("HintThread")

  // Set when the child closes the card. It hides the tip from them without
  // touching what the teacher approved, so the record stays intact.
  dismissedAt DateTime?

  // Set when this hint reached the child with no teacher online to read it
  // first. approvedById is null in that case, which on its own is
  // indistinguishable from a data problem, so the fact is recorded outright.
  // Teachers see everything carrying this stamp, after the event.
  autoApprovedAt DateTime?
}

model SkillMastery {
  id        String       @id @default(cuid())
  skill     String
  level     MasteryLevel @default(NOT_STARTED)
  updatedAt DateTime     @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, skill])
}

model StudentProgress {
  id         String   @id @default(cuid())
  completed  Boolean  @default(false)
  blocksUsed Int      @default(0)
  updatedAt  DateTime @updatedAt

  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])

  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
}

model Consent {
  id        String   @id @default(cuid())
  grantedAt DateTime @default(now())

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
}

// ----------- Enums -------------

enum Role {
  STUDENT
  TEACHER
  PARENT
  // An admin has no profile row. The other three roles each point at a person
  // in a classroom; an admin is an operator of the system, so their User row
  // stands alone. Admins are made by scripts/make-admin.ts, never by signing
  // up, so nobody can grant themselves the run of the curriculum.
  ADMIN
}

enum EnrolmentStatus {
  TRIAL
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum HintStatus {
  PROPOSED
  APPROVED
  DELIVERED
  REJECTED
}

enum MasteryLevel {
  NOT_STARTED
  LEARNING
  PRACTISING
  MASTERED
}